APP_ENV=development
DATABASE_URL=sqlite:///./var/argos.db
SQLITE_BUSY_TIMEOUT_MS=5000
ARGOS_BACKUP_DIR=backups/sqlite
LOCAL_TIMEZONE=Europe/Madrid
LOG_LEVEL=INFO
STATION_SLUG=tomillar
ARGOS_ADMIN_TOKEN=change-me-admin-token
ECOWITT_INGEST_TOKEN=change-me-random-token
ECOWITT_CAPTURE_RAW=false
ECOWITT_EXPECTED_INTERVAL_SECONDS=60
ECOWITT_OFFLINE_AFTER_SECONDS=180
ECOWITT_CLOUD_BASE_URL=https://api.ecowitt.net
ECOWITT_CLOUD_API_VERSION=v3
ECOWITT_CLOUD_APPLICATION_KEY=
ECOWITT_CLOUD_API_KEY=
ECOWITT_CLOUD_MAC=
ECOWITT_CLOUD_TIMEOUT_SECONDS=10
ECOWITT_CLOUD_MAX_BACKFILL_HOURS=24
ECOWITT_CLOUD_SYNC_LOOKBACK_HOURS=24
ARGOS_SATELLITE_ENABLED=false
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
COPERNICUS_CATALOG_URL=https://sh.dataspace.copernicus.eu/catalog/v1
COPERNICUS_STATISTICS_URL=https://sh.dataspace.copernicus.eu/statistics/v1
COPERNICUS_PROCESS_URL=https://sh.dataspace.copernicus.eu/process/v1
# Preferred multi-AOI format. Keep it on one line in .env.
# Example: ARGOS_SATELLITE_AOIS_JSON={"olivos_pequenos":{"name":"Olivos pequenos","geometry":{"type":"Polygon","coordinates":[[[-3.700,37.100],[-3.699,37.100],[-3.699,37.101],[-3.700,37.101],[-3.700,37.100]]]}},"olivos_grandes":{"name":"Olivos grandes","geometry":{"type":"Polygon","coordinates":[[[-3.702,37.102],[-3.701,37.102],[-3.701,37.103],[-3.702,37.103],[-3.702,37.102]]]}}}
ARGOS_SATELLITE_AOIS_JSON=
ARGOS_SATELLITE_HISTORY_DAYS=730
ARGOS_SATELLITE_MAX_CLOUD_COVER=60
ARGOS_SATELLITE_MIN_VALID_PIXEL_FRACTION=0.20
ARGOS_SATELLITE_VALID_PIXEL_FRACTION=0.50
ARGOS_SATELLITE_UPDATE_INTERVAL_HOURS=24
ARGOS_SATELLITE_PREVIEW_ENABLED=true
ARGOS_SATELLITE_ASSET_DIR=data/satellite
ARGOS_SATELLITE_HTTP_TIMEOUT_SECONDS=30
AEMET_API_KEY=
AEMET_STATION_ID=6127X
AEMET_BASE_URL=https://opendata.aemet.es/opendata/api
AEMET_TIMEOUT_SECONDS=20
AEMET_MAX_RETRIES=3
AEMET_BACKOFF_SECONDS=0.5
AEMET_BLOCK_DAYS=31
AEMET_SYNC_LOOKBACK_DAYS=7
AEMET_BACKFILL_START_DATE=1900-01-01
AEMET_SEED_CSV_PATH=
ARGOS_NODE_URL=
ARGOS_NODE_TIMEOUT_SECONDS=5
ARGOS_NODE_POLL_INTERVAL_SECONDS=5
ARGOS_FLOWMETER_HYDROLOGICAL_YEAR_RESET_MONTH=10
ARGOS_FLOWMETER_HYDROLOGICAL_YEAR_RESET_DAY=1
ARGOS_DAILY_SYNC_ENABLED=true
ARGOS_DAILY_SYNC_INTERVAL_HOURS=24
